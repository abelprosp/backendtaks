# Ambiente
NODE_ENV=development
PORT=4000

# Frontend autorizado no CORS (aceita lista separada por vírgula)
FRONTEND_URL=http://localhost:3000
# Compatibilidade com a configuração antiga
FRONTEND_ORIGIN=http://localhost:3000

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
# Opcional no backend; mantido para referência e integrações auxiliares
SUPABASE_ANON_KEY=sua-chave-anonima
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Postgres do Supabase (legado / schema auxiliar)
# A API C# atual usa o REST do Supabase em runtime; mantenha estas URLs apenas se ainda for usar Prisma/scripts.
DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.seu-projeto.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[SUA-SENHA]@db.seu-projeto.supabase.co:5432/postgres

# Auth JWT
JWT_SECRET=troque-essa-chave
JWT_REFRESH_SECRET=troque-essa-chave-tambem
JWT_EXPIRES_IN=30d
REFRESH_EXPIRES_IN=365d

# Storage / arquivos
SUPABASE_STORAGE_BUCKET=demandas-anexos
UPLOAD_DIR=./uploads

# Sistema antigo: usado para linkar/baixar anexos sem copiar arquivos para o Supabase.
# Use HTTP: o legado não atende HTTPS na porta 443.
LEGACY_BASE_URL=http://luxusweb.com.br
LEGACY_EMAIL=
LEGACY_PASSWORD=
PREFER_LEGACY_ATTACHMENTS=true
# Se true, bloqueia upload em Supabase/local quando a demanda não tem legacy_id.
REQUIRE_LEGACY_ATTACHMENTS=false

# IA (opcional)
OPENAI_API_KEY=

# Scripts auxiliares locais
API_URL=http://localhost:4000

# Reverse proxy HTTPS para VPS/container
API_DOMAIN=api.seu-dominio.com
CADDY_EMAIL=seu-email@dominio.com

# Integração servidor-a-servidor com o Luxus Parceiros
LUXUS_PARCEIROS_INTEGRATION_KEY=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
LUXUS_PARCEIROS_CALLBACK_URL=https://API-DO-LUXUS-PARCEIROS.up.railway.app/api/integrations/luxus-task/callback
LUXUS_PARCEIROS_TECHNICAL_USER_EMAIL=luxusparceiros@integration.local
# Opcional: UUID do template. Se vazio, busca pelo nome abaixo.
LUXUS_PARCEIROS_SALE_TEMPLATE_ID=
LUXUS_PARCEIROS_SALE_TEMPLATE_NAME=ALEX - PARCEIRO (META ou LINGO ou ELITE ou RAELCELL) - Venda linha nova VIVO
